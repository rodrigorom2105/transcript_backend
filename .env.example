# Runtime
NODE_ENV=production
PORT=3000

# Postgres 16 (servicio nativo en Ubuntu — ver deploy/README.md para setup)
DATABASE_URL=postgresql://iul:CHANGE_ME@localhost:5432/iul_assistant

# Redis 7 (servicio nativo en Ubuntu)
REDIS_URL=redis://localhost:6379

# Deepgram STT
DEEPGRAM_API_KEY=

# OpenClaw LLM gateway (mismo Droplet, comunicación localhost)
OPENCLAW_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=discord-bot
OPENCLAW_MODEL=openclaw/discord-bot
OPENCLAW_REQUEST_TIMEOUT_MS=120000  

# Copilot en vivo (GPT API directo recomendado)
OPENAI_API_KEY=
GPT_MODEL=gpt-4.1-mini
GPT_REQUEST_TIMEOUT_MS=30000
COPILOT_ENABLED=true
COPILOT_PROVIDER=gpt_api
COPILOT_MIN_SECONDS_BETWEEN_SUGGESTIONS=20
COPILOT_RECENT_WINDOW_MS=180000

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Debe coincidir exactamente con el redirect URI registrado en Discord Developer Portal
DISCORD_REDIRECT_URI=https://tuapp.vercel.app/auth/callback

# JWT (backend propio — NO es el token de Discord)
# Generar con: openssl rand -base64 48
JWT_SECRET=

# Shared secret entre el bot de Discord y este backend
# Generar con: openssl rand -base64 32
INTERNAL_SECRET=

# CORS — origen exacto del frontend de agentes (sin trailing slash)
FRONTEND_ORIGIN=https://tuapp.vercel.app
# Orígenes extra separados por coma para previews/dev remoto, sin trailing slash
FRONTEND_EXTRA_ORIGINS=
# Origen del dashboard administrativo — agregar cuando esté hosteado (sin trailing slash)
# DASHBOARD_ORIGIN=https://dashboard.tudominio.com

# Google Sheets (clock-in/out mirror)
# Ruta al JSON de la service account de Google (credenciales del proyecto de Google Cloud)
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/iul/google-service-account.json
# ID del spreadsheet compartido (extraído de la URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=
# Zona horaria para mostrar la hora en Sheets y en respuestas al bot (default: America/Los_Angeles)
CLOCK_TIMEZONE=America/Los_Angeles

# Dashboard web (autenticación separada de Discord)
# Generar con: openssl rand -base64 48
DASHBOARD_JWT_SECRET=
# Duración del token del dashboard en horas (default: 8)
DASHBOARD_JWT_TTL_HOURS=8
