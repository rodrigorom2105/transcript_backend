# Runtime
NODE_ENV=production
PORT=3000

# Postgres 16 (servicio nativo en Ubuntu — ver deploy/README.md para setup)
DATABASE_URL=postgresql://iul:CHANGE_ME@localhost:5432/iul_assistant

# Redis 7 (servicio nativo en Ubuntu)
REDIS_URL=redis://localhost:6379

# Deepgram STT
DEEPGRAM_API_KEY=

# OpenClaw LLM (mismo Droplet, comunicación localhost)
# TODO: reemplazar PUERTO_OPENCLAW con el puerto real de OpenClaw
OPENCLAW_URL=http://localhost:PUERTO_OPENCLAW

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Debe coincidir exactamente con el redirect URI registrado en Discord Developer Portal
DISCORD_REDIRECT_URI=https://tuapp.vercel.app/auth/callback

# JWT (backend propio — NO es el token de Discord)
# Generar con: openssl rand -base64 48
JWT_SECRET=

# Shared secret entre el bot de Discord y este backend
# Generar con: openssl rand -base64 32
INTERNAL_SECRET=

# CORS — origen exacto del frontend (sin trailing slash)
FRONTEND_ORIGIN=https://tuapp.vercel.app
