[Unit]
Description=IUL Call Center Backend
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=iul
WorkingDirectory=/opt/iul-backend
EnvironmentFile=/etc/iul-backend.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iul-backend

# Hardening mínimo
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
